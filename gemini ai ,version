        interact_variable = get_user_input()
        process_interaction(interact_variable) // Function to handle the interaction logic
        action_active = true
    } else if (input_choice == 2) { // Placeholder 1
        display_message("Enter value for Placeholder 1:")
        placeholder1 = get_user_input()
        process_placeholder1(placeholder1) // Function to handle placeholder 1 logic
        action_active = true
    } else if (input_choice == 3) { // Placeholder 2
        display_message("Enter value for Placeholder 2:")
        placeholder2 = get_user_input()
        process_placeholder2(placeholder2) // Function to handle placeholder 2 logic
        action_active = true
    } else if (input_choice == "exit" or input_choice == "quit") { // Allow exiting
        break // Exit the loop
    } else {
        display_message("Invalid choice. Please try again.")
    }

    if (action_active) {
        display_results(interact_variable, placeholder1, placeholder2) // Display current values
        action_active = false // Reset for the next action
    }
}


